/* ============================================
   文件全能转化助手 — 全局 QSS 主题
   配色：蓝灰主色 + 浅灰背景 + 白色卡片
   ============================================ */

/* --- 全局 --- */
QWidget {
    font-family: "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #2C3E50;
    background-color: #F5F6FA;
}

/* --- 主窗口 --- */
QMainWindow {
    background-color: #F5F6FA;
}

QMainWindow::separator {
    width: 1px;
    background-color: #E0E4E8;
}

/* --- 菜单栏 --- */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8ECF0;
    padding: 4px 8px;
    font-size: 13px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
    margin: 2px 4px;
}

QMenuBar::item:selected {
    background-color: #E8F0FB;
    color: #4A90D9;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E4E8;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E8F0FB;
    color: #4A90D9;
}

/* --- 状态栏 --- */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E8ECF0;
    color: #7F8C9B;
    font-size: 12px;
    padding: 4px 12px;
}

/* --- 滚动条 --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C4CDD5;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #A0AAB4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #C4CDD5;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #A0AAB4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- 按钮 --- */
QPushButton {
    background-color: #4A90D9;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #5A9EE5;
}

QPushButton:pressed {
    background-color: #3A7BC0;
}

QPushButton:disabled {
    background-color: #C4CDD5;
    color: #8F9BA8;
}

QPushButton#secondaryBtn {
    background-color: #FFFFFF;
    color: #4A90D9;
    border: 1.5px solid #4A90D9;
}

QPushButton#secondaryBtn:hover {
    background-color: #E8F0FB;
}

QPushButton#dangerBtn {
    background-color: #E74C3C;
}

QPushButton#dangerBtn:hover {
    background-color: #F06050;
}

QPushButton#removeBtn {
    background-color: transparent;
    color: #E74C3C;
    border: none;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: normal;
}

QPushButton#removeBtn:hover {
    color: #C0392B;
    background-color: #FDEDEC;
}

/* --- 输入框 --- */
QLineEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #DDE1E6;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #2C3E50;
}

QLineEdit:focus {
    border-color: #4A90D9;
}

QLineEdit:disabled {
    background-color: #F0F2F5;
    color: #A0AAB4;
}

/* --- 下拉框 --- */
QComboBox {
    background-color: #FFFFFF;
    border: 1.5px solid #DDE1E6;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #4A90D9;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E4E8;
    border-radius: 6px;
    selection-background-color: #E8F0FB;
    selection-color: #4A90D9;
}

/* --- 进度条 --- */
QProgressBar {
    background-color: #E8ECF0;
    border: none;
    border-radius: 6px;
    height: 8px;
    text-align: center;
    font-size: 11px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #4A90D9;
    border-radius: 6px;
}

/* --- 分组框 --- */
QGroupBox {
    font-weight: bold;
    color: #2C3E50;
    border: 1.5px solid #E8ECF0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    margin-left: 12px;
    color: #4A90D9;
}

/* --- 标签 --- */
QLabel {
    color: #2C3E50;
    background: transparent;
}

QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: #2C3E50;
}

QLabel#subtitleLabel {
    font-size: 12px;
    color: #7F8C9B;
}

QLabel#dropHintLabel {
    font-size: 14px;
    color: #7F8C9B;
}

/* --- 列表 --- */
QListWidget {
    background-color: #FFFFFF;
    border: 1.5px solid #E8ECF0;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 2px 4px;
}

QListWidget::item:hover {
    background-color: #F0F4F8;
}

QListWidget::item:selected {
    background-color: #E8F0FB;
    color: #2C3E50;
}

/* --- 工具提示 --- */
QToolTip {
    background-color: #2C3E50;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* --- 对话框 --- */
QDialog {
    background-color: #F5F6FA;
}

/* --- 标签页 --- */
QTabWidget::pane {
    border: 1.5px solid #E8ECF0;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #F0F2F5;
    border: none;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #4A90D9;
}

QTabBar::tab:hover:!selected {
    background-color: #E8ECF0;
}

/* --- 复选框 --- */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #C4CDD5;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #4A90D9;
    border-color: #4A90D9;
}

/* --- 分割线 --- */
QFrame#separator {
    background-color: #E8ECF0;
    border: none;
}
